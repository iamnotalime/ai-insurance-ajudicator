# ============================================================
# Insurance Adjudicator - Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Environment ---
ENVIRONMENT=development   # development | staging | production

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurance_adjudicator
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL_MODE=prefer
DB_AUTO_CREATE_TABLES=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# --- LLM Provider ---
LLM_PROVIDER=mock          # anthropic | openai | mock
LLM_API_KEY=               # Required for anthropic/openai
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_FALLBACK_MODEL=

# --- Security ---
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=             # Required in production for PII encryption
API_KEYS=dev-api-key-1,dev-api-key-2
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Production hard requirements:
# - ENVIRONMENT=production
# - DB_AUTO_CREATE_TABLES=false
# - JWT_SECRET length >= 32
# - ENCRYPTION_KEY must decode to exactly 32 bytes
# - API_KEYS must be high-entropy values, each length >= 24
# - CORS_ORIGINS and ALLOWED_HOSTS must be explicit, never *
# - LLM_PROVIDER cannot be mock

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000
RATE_LIMIT_BURST=10
RATE_LIMIT_ENDPOINT_OVERRIDES=

# --- Circuit Breaker ---
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=3
CB_TIMEOUT_SECONDS=60
CB_HALF_OPEN_MAX_CALLS=3

# --- Agent Orchestration ---
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300
AGENT_RETRY_ATTEMPTS=3
AGENT_PARALLEL=5
AGENT_CONFIDENCE_THRESHOLD=0.85
AGENT_HUMAN_REVIEW_THRESHOLD=0.70
AGENT_MIN_CONFIDENCE_FLOOR=0.40
AGENT_DOC_EXTRACTION_TIMEOUT=60
AGENT_POLICY_ANALYSIS_TIMEOUT=45
AGENT_FRAUD_DETECTION_TIMEOUT=60
AGENT_DECISION_TIMEOUT=45

# --- Fraud Detection ---
FRAUD_HIGH_RISK_THRESHOLD=0.7
FRAUD_MEDIUM_RISK_THRESHOLD=0.5
FRAUD_AUTO_DENY_THRESHOLD=0.85
FRAUD_ROUND_NUMBER_VARIANCE=0.05
FRAUD_HISTORY_WEIGHT=0.2
FRAUD_PATTERN_WEIGHT=0.3
FRAUD_DOCUMENT_WEIGHT=0.25
FRAUD_BEHAVIOR_WEIGHT=0.25

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=true
METRICS_PORT=9090
JAEGER_ENDPOINT=            # e.g., http://localhost:14268/api/traces
PROMETHEUS_MULTIPROC_DIR=

# --- Feature Flags ---
FF_FRAUD_DETECTION=true
FF_DOCUMENT_EXTRACTION=true
FF_AUTO_ADJUDICATION=true
FF_PARALLEL_AGENTS=true
FF_ADAPTIVE_ORCHESTRATION=true
FF_PII_ENCRYPTION=true
FF_AUDIT_LOGGING=true
FF_RATE_LIMITING=true
FF_METRICS=true
FF_TRACING=true
FF_USE_DATABASE=true
